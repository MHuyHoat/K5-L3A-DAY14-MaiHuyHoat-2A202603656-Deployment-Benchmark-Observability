# ============================================================
# Biến môi trường của agent — copy thành .env rồi điền giá trị thật.
# KHÔNG commit .env (đã nằm trong .gitignore). Trên cloud: đặt trong dashboard.
# ============================================================

# HTTP
PORT=8000
ENVIRONMENT=development

# Secret dùng để xác thực header X-API-Key (bắt buộc)
AGENT_API_KEY=change-me-in-production

# Redis: rate limit + cost guard (state dùng chung giữa các instance)
REDIS_URL=redis://localhost:6379/0

# Giới hạn tần suất mỗi API key
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# Ngân sách LLM (đặt một trong hai; DAILY được ưu tiên nếu có cả hai)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0

# Log
LOG_LEVEL=INFO
